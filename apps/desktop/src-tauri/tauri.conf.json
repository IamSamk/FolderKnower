{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Architekton",
  "version": "0.3.1",
  "identifier": "dev.architekton.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Architekton",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "dragDropEnabled": true,
        "backgroundColor": "#0B0E14"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "See how any codebase is built",
    "longDescription": "Architekton reads a local repository offline and draws its architecture: tiers, subsystems, files, call graphs, API flows and the database, with every edge backed by static evidence.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "licenseFile": "EULA.txt",
    "copyright": "Copyright (c) 2026 IamSamk. MIT OR Apache-2.0.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFENkZDNjkzNkM0MEQ2N0MKUldSODFrQnNrOFp2SGRabkl3eHlrL3Urb0Iva01admk1WGRjUWJiUGJINmdDZDdvNnJxOFROWWoK",
      "endpoints": ["https://github.com/IamSamk/Architekton/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
